# MyServer ortam dosyası - /etc/myserver/myserver.env
# Sahip: root:myserver, izin: 0640
# Biçim: ANAHTAR=değer (tırnak ve boşluk kullanmayın). Değişiklikten sonra:
#   sudo systemctl restart myserver
#
# Kurulum betiği yeniden çalıştırıldığında bu dosya KORUNUR; yalnızca açıkça
# verilen seçeneklere karşılık gelen satırlar güncellenir.

# Panelin dinlediği adres. ":8080" tüm arayüzler demektir. Yalnızca belirli
# bir adreste dinlemek için "192.168.1.10:8080" biçimini kullanın.
# 1024'ten küçük portlar desteklenmez (servis root değildir).
MYSERVER_LISTEN=:8080

# Veri dizini (SQLite veritabanı, yedekler, uygulama verileri).
MYSERVER_DATA_DIR=/var/lib/myserver

# Uygulama tanımlarının (manifest) dizini. Simgeler bunun yanındaki "icons"
# dizininden okunur.
MYSERVER_MANIFEST_DIR=/usr/local/share/myserver/apps/manifests

# Root yardımcısının yolu. sudoers kuralı bu yola göre yazılmıştır;
# değiştirirseniz yardımcı çalışmaz.
MYSERVER_HELPER=/usr/local/libexec/myserver-helper

# Docker soketi. Yalnızca yerel unix soketi desteklenir; Docker TCP soketini
# etkinleştirmeyin.
MYSERVER_DOCKER_HOST=unix:///var/run/docker.sock

# Günlük düzeyi: debug, info, warn, error
MYSERVER_LOG_LEVEL=info

# Panel bir TLS ters vekil sunucusunun (reverse proxy) arkasındaysa "true"
# yapın; çerezler yalnızca HTTPS üzerinden gönderilir.
#MYSERVER_COOKIE_SECURE=true

# Web terminalinin varsayılan kullanıcısı. Kurulum betiği, kurulumu başlatan
# gerçek kullanıcıyı (SUDO_USER) buraya yazar.
#MYSERVER_TERMINAL_DEFAULT_USER=

# Sürüm dosyalarının indirileceği temel adres (güncelleme betiği kullanır).
# Proje sahibinin yayın adresi belirlendiğinde ayarlanır.
#MYSERVER_RELEASE_URL=
